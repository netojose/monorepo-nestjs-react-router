{
  "name": "platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f apps/api/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f apps/api/docker-compose.yml down",
    "docker:api": "docker compose -f apps/api/docker-compose.yml up --build",
    "docker:api:down": "docker compose -f apps/api/docker-compose.yml down",
    "docker:web": "docker compose -f apps/web/docker-compose.yml up --build",
    "docker:web:down": "docker compose -f apps/web/docker-compose.yml down",
    "docker:api:prod": "docker compose -f apps/api/docker-compose.yml -f apps/api/docker-compose.prod.yml up --build",
    "docker:api:prod:down": "docker compose -f apps/api/docker-compose.yml -f apps/api/docker-compose.prod.yml down",
    "docker:web:prod": "docker compose -f apps/web/docker-compose.yml -f apps/web/docker-compose.prod.yml up --build",
    "docker:web:prod:down": "docker compose -f apps/web/docker-compose.yml -f apps/web/docker-compose.prod.yml down"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/fastify": "^9.10.1",
    "@bull-board/nestjs": "^9.10.1",
    "@fastify/helmet": "^13.1.1",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "bullmq": "^6.3.8",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "helmet": "^8.3.0",
    "keyv": "^5.6.0",
    "radash": "^12.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1"
}
