{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-floating-promises": "error",
    "eslint/no-unused-vars": "error"
  },
  "env": {
    "node": true
  },
  "options": {
    "typeAware": true
  }
}
